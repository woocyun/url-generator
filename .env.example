# Copy to .env before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener
POSTGRES_DB=urlshortener
POSTGRES_PORT=5432

# --- API service ---
API_PORT=4000
# Connection string used by the API container (host is the compose service name).
DATABASE_URL=postgres://urlshortener:urlshortener@postgres:5432/urlshortener
# Max Postgres connections held by one API instance. Postgres allows 100 in
# total, so leave headroom for the migrate job and for a psql session.
DATABASE_POOL_MAX=10
# Origin that short links are handed out under. The API serves the redirect, so
# this is the API's own public address, not the web app's.
PUBLIC_BASE_URL=http://localhost:4000

# --- Redis cache (ADR 0009) ---
# Optional. Unset runs the read path straight against Postgres — correct, just
# slower — which is what makes the cache safe to lose in production and easy to
# skip when running the API outside Compose.
REDIS_URL=redis://redis:6379
REDIS_PORT=6379
# Bound on the cache container's memory. Full means evict (allkeys-lru), so
# this is a size limit rather than a capacity that can be exhausted.
REDIS_MAXMEMORY=256mb
# How long a resolved mapping stays cached. A bound on how long a deleted row
# can still be served, not a refresh interval: the cached columns do not change
# while the row exists.
CACHE_TTL_SECONDS=3600
# How long "no such code" stays cached. Short, because a POST /shorten can end
# that absence at any moment; the write path also deletes the entry, and this
# TTL covers the case where Redis was unreachable when it tried.
CACHE_NEGATIVE_TTL_SECONDS=30

# --- Web service ---
WEB_PORT=3000
# Server-side calls from the Next.js container to the API container.
API_INTERNAL_URL=http://api:4000
# Browser-side calls from the user's machine to the API container's published port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
