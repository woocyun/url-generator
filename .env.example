# Copy to .env before running `docker compose up`.

# --- Postgres ---
POSTGRES_USER=urlshortener
POSTGRES_PASSWORD=urlshortener
POSTGRES_DB=urlshortener
POSTGRES_PORT=5432

# --- API service ---
API_PORT=4000
# Connection string used by the API container (host is the compose service name).
DATABASE_URL=postgres://urlshortener:urlshortener@postgres:5432/urlshortener

# --- Web service ---
WEB_PORT=3000
# Server-side calls from the Next.js container to the API container.
API_INTERNAL_URL=http://api:4000
# Browser-side calls from the user's machine to the API container's published port.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
